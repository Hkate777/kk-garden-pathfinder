# Copy to .env and fill in. .env is git-ignored — keys never enter the repo.

# Inference: any OpenAI-compatible endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
VISION_MODEL=gpt-4o-mini
TEXT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Pipeline knobs
GROUNDING_THRESHOLD=0.42      # below this a knowledge point is reported unmapped, never guessed
CONFIDENCE_REVIEW=0.60        # below this the diagnosis is flagged for a teacher's check
MAX_PRACTICE_PER_DAY=3

# Run without any API key (rule-based baseline, clearly labelled as such)
PATHFINDER_OFFLINE=0

# Storage
DB_PATH=data/pathfinder.db

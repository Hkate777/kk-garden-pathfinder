{
  "note": "Regex matchers powering the offline (no-API-key) grounding path. The real path uses embeddings from EMBEDDING_MODEL; these exist so the pipeline is runnable and testable with no keys.",
  "matchers": {
    "ALG-7.1": ["\\d*[a-z]\\s*\\+\\s*\\d*[a-z]", "combine|simplify"],
    "ALG-7.2": ["[a-z]\\s*[+-]\\s*\\d+\\s*=\\s*\\d+", "solve|find the value"],
    "ALG-7.3": ["\\d+\\s*\\([a-z]\\s*[+-]\\s*\\d+\\)", "\\([a-z]\\s*[+-]\\s*\\d+\\)"],
    "ALG-7.4": ["\\d+\\s*/\\s*\\d+\\s*[+-]\\s*\\d+\\s*/\\s*\\d+", "/\\s*\\d+"],
    "ALG-8.1": ["[a-z]\\^\\s*\\d+", "simplify|power|exponent"],
    "ALG-8.3": ["\\([a-z]\\s*[+-]\\s*[a-z]\\)\\s*\\^?\\s*?2", "[a-z]\\^?2\\s*\\+\\s*[a-z]\\^?2"],
    "PHY-9.1": ["F\\s*=\\s*ma", "force|acceleration"],
    "PHY-9.2": ["km/h|m/s", "\\d+\\s*g\\b", "kg|convert"],
    "CHE-8.1": ["->", "balance|equation"],
    "ENG-7.1": ["\\b(is|are|go|goes|have|has)\\b", "subject|verb"]
  }
}
